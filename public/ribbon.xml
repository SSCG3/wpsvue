<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="ribbon.OnAddinLoad">
    <ribbon startFromScratch="false">
        <tabs>
            <!-- 智能重写功能 Tab -->
            <tab id="wpsAddinRewriteTab" label="智能重写">
				<group id="btnMainGroup" label="主要功能">
                    <button
                        id="btnStart"
                        label="开始"
                        onAction="ribbon.OnAction"
                        getImage="ribbon.GetImage"
                        size="large"
                        screentip="打开智能重写工具"
                        supertip="点击此按钮打开智能重写侧边栏，可进行扩写、续写、改写、缩写操作"
                    />
                    <button
                        id="btnHelp"
                        label="帮助"
                        onAction="ribbon.OnAction"
                        getImage="ribbon.GetImage"
                        size="large"
                        screentip="查看使用帮助"
                        supertip="查看智能重写功能的详细使用说明和操作指南"
                    />
                    <button
                        id="btnAbout"
                        label="关于"
                        onAction="ribbon.OnAction"
                        getImage="ribbon.GetImage"
                        size="large"
                        screentip="关于本插件"
                        supertip="查看插件版本信息和开发团队"
                    />
				</group>
            </tab>
        </tabs>
    </ribbon>
</customUI>